# 统一换行符：源码一律 LF 入库，避免 Windows 检出时被转成 CRLF
* text=auto eol=lf

# 明确的文本类型
*.js      text eol=lf
*.mjs     text eol=lf
*.json    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.sh      text eol=lf

# Windows 专用脚本保留 CRLF
*.bat     text eol=crlf
*.ps1     text eol=crlf

# 二进制文件不做行尾转换
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.zip     binary
*.tgz     binary
*.woff    binary
*.woff2   binary
